{
  "name": "carisca-api",
  "version": "0.1.0",
  "private": true,
  "description": "CARISCA Integrated Events & Programs Platform — API",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "worker": "node worker.js",
    "mail:test": "node scripts/send-test-email.js",
    "storage:test": "node scripts/test-storage.js",
    "sq": "sequelize-cli --config src/database/cli-config.cjs --migrations-path src/database/migrations --seeders-path src/database/seeders",
    "db:create": "npm run sq -- db:create",
    "db:drop": "npm run sq -- db:drop",
    "db:migrate": "npm run sq -- db:migrate",
    "db:migrate:undo": "npm run sq -- db:migrate:undo",
    "db:migrate:status": "npm run sq -- db:migrate:status",
    "db:seed": "npm run sq -- db:seed:all",
    "db:seed:undo": "npm run sq -- db:seed:undo:all",
    "db:reset": "npm run db:drop --if-present; npm run db:create && npm run db:migrate && npm run db:seed",
    "test": "NODE_ENV=test node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "test:watch": "NODE_ENV=test node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --watch",
    "lint": "eslint src tests"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1111.0",
    "@aws-sdk/s3-request-presigner": "^3.1111.0",
    "@googleapis/drive": "^21.0.0",
    "argon2": "^0.41.1",
    "bullmq": "^5.34.2",
    "compression": "^1.7.5",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.2",
    "mysql2": "^3.12.0",
    "nodemailer": "^6.10.1",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "puppeteer": "^25.8.0",
    "qrcode": "^1.5.4",
    "rate-limit-redis": "^4.2.0",
    "sanitize-html": "^2.17.7",
    "sequelize": "^6.37.5",
    "ulid": "^2.3.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "eslint": "^9.17.0",
    "jest": "^29.7.0",
    "sequelize-cli": "^6.6.2",
    "supertest": "^7.0.0"
  },
  "overrides": {
    "sanitize-html": {
      "htmlparser2": "9.1.0"
    }
  }
}
