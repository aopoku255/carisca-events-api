# ---------------------------------------------------------------------------
# CARISCA API — copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000

# --- database --------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=carisca_dev
DB_USER=root
DB_PASSWORD=
DB_LOGGING=false

# --- redis -----------------------------------------------------------------
REDIS_URL=redis://127.0.0.1:6379

# --- auth ------------------------------------------------------------------
# Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=change-me-to-at-least-32-characters-long
JWT_REFRESH_SECRET=change-me-to-a-different-32-character-value
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
EMAIL_VERIFICATION_TTL_HOURS=48
PASSWORD_RESET_TTL_MINUTES=60

# --- platform behaviour ----------------------------------------------------
REGISTRATION_HOLD_MINUTES=30
PERMISSION_CACHE_TTL_SECONDS=60
CORS_ORIGINS=http://localhost:3000

# --- payment providers (sandbox keys during development) -------------------
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- mail ------------------------------------------------------------------
# log  = write the message to the log, send nothing (development and test)
# smtp = deliver for real; SMTP_HOST becomes required
MAIL_DRIVER=log
MAIL_FROM=CARISCA <no-reply@carisca.knust.edu.gh>
MAIL_REPLY_TO=

# Required when MAIL_DRIVER=smtp. Use port 465 with SMTP_SECURE=true, or
# port 587 with SMTP_SECURE=false (STARTTLS is negotiated automatically).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_POOL_MAX_CONNECTIONS=3
# Only for a relay with a self-signed certificate. Rejected in production.
SMTP_ALLOW_SELF_SIGNED=false

# --- storage ---------------------------------------------------------------
# local  = files on this machine's disk (development)
# r2     = Cloudflare R2 (S3-compatible object storage) — the production choice
# gdrive = a folder inside a Google Shared Drive
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage

# Only read when STORAGE_DRIVER=r2. Create the bucket and an R2 API token in
# the Cloudflare dashboard: R2 > Manage API tokens > Object Read & Write.
# The account id is in the R2 sidebar, and in the S3 endpoint it shows you.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Optional. Overrides the endpoint derived from the account id — only needed
# for a jurisdiction-specific endpoint, or an S3-compatible server for testing.
R2_ENDPOINT=
R2_FORCE_PATH_STYLE=false

# Only read when STORAGE_DRIVER=gdrive. The folder MUST be in a Shared Drive:
# a service account has no storage quota in a personal My Drive, so uploads
# there fail. Take the id from the folder URL:
#   drive.google.com/drive/folders/<GOOGLE_DRIVE_FOLDER_ID>
GOOGLE_DRIVE_FOLDER_ID=
# Path to the service account JSON key (gitignored), or paste the key inline
# as JSON/base64 for hosts with no filesystem to put it on.
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=./service-account.json
GOOGLE_SERVICE_ACCOUNT_KEY_JSON=
# Only needed if the folder is in a My Drive rather than a Shared Drive. Files
# are then owned by this user and use their quota. Requires domain-wide
# delegation to be authorised in the Workspace admin console.
GOOGLE_DRIVE_IMPERSONATE_USER=

LOG_LEVEL=info
