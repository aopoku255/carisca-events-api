# ---------------------------------------------------------------------------
# CARISCA API — copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000

# --- database --------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=carisca_dev
DB_USER=root
DB_PASSWORD=
DB_LOGGING=false

# --- redis -----------------------------------------------------------------
REDIS_URL=redis://127.0.0.1:6379

# --- auth ------------------------------------------------------------------
# Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=change-me-to-at-least-32-characters-long
JWT_REFRESH_SECRET=change-me-to-a-different-32-character-value
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
EMAIL_VERIFICATION_TTL_HOURS=48
PASSWORD_RESET_TTL_MINUTES=60

# --- platform behaviour ----------------------------------------------------
REGISTRATION_HOLD_MINUTES=30
PERMISSION_CACHE_TTL_SECONDS=60
CORS_ORIGINS=http://localhost:3000

# --- payment providers (sandbox keys during development) -------------------
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- mail / storage --------------------------------------------------------
MAIL_DRIVER=log
MAIL_FROM=CARISCA <no-reply@carisca.knust.edu.gh>
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage

LOG_LEVEL=info
